# GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=debug_x64
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug_x64)
  x_snitch_config = debug_x64
  x_nanobench_config = debug_x64
  vmlib_config = debug_x64
  tests_config = debug_x64
  bench_config = debug_x64

else ifeq ($(config),release_x64)
  x_snitch_config = release_x64
  x_nanobench_config = release_x64
  vmlib_config = release_x64
  tests_config = release_x64
  bench_config = release_x64

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := x-snitch x-nanobench vmlib tests bench

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

x-snitch:
ifneq (,$(x_snitch_config))
	@echo "==== Building x-snitch ($(x_snitch_config)) ===="
	@${MAKE} --no-print-directory -C third_party -f x-snitch.make config=$(x_snitch_config)
endif

x-nanobench:
ifneq (,$(x_nanobench_config))
	@echo "==== Building x-nanobench ($(x_nanobench_config)) ===="
	@${MAKE} --no-print-directory -C third_party -f x-nanobench.make config=$(x_nanobench_config)
endif

vmlib:
ifneq (,$(vmlib_config))
	@echo "==== Building vmlib ($(vmlib_config)) ===="
	@${MAKE} --no-print-directory -C vmlib -f Makefile config=$(vmlib_config)
endif

tests: vmlib x-snitch
ifneq (,$(tests_config))
	@echo "==== Building tests ($(tests_config)) ===="
	@${MAKE} --no-print-directory -C tests -f Makefile config=$(tests_config)
endif

bench: vmlib x-nanobench
ifneq (,$(bench_config))
	@echo "==== Building bench ($(bench_config)) ===="
	@${MAKE} --no-print-directory -C bench -f Makefile config=$(bench_config)
endif

clean:
	@${MAKE} --no-print-directory -C third_party -f x-snitch.make clean
	@${MAKE} --no-print-directory -C third_party -f x-nanobench.make clean
	@${MAKE} --no-print-directory -C vmlib -f Makefile clean
	@${MAKE} --no-print-directory -C tests -f Makefile clean
	@${MAKE} --no-print-directory -C bench -f Makefile clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug_x64"
	@echo "  release_x64"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   x-snitch"
	@echo "   x-nanobench"
	@echo "   vmlib"
	@echo "   tests"
	@echo "   bench"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"